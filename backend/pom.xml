<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        WHY Spring Boot parent?
        Provides dependency management, plugin defaults, and version-aligned
        transitive deps so we never get version conflicts across the stack.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.moviedb</groupId>
    <artifactId>moviedb-api</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>MovieDB API</name>
    <description>
        MovieDB REST API — Production-grade Spring Boot 3 / Java 21 backend.
        Follows Amazon-level layered architecture:
        Controller → Service → Repository → Entity.
    </description>

    <properties>
        <java.version>21</java.version>
        <!-- Pinned so JJWT API/impl/jackson stay in sync -->
        <jjwt.version>0.11.5</jjwt.version>

    </properties>

    <dependencies>

        <!-- ── Core Web MVC (includes Jackson, Tomcat, validation) ─────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ── JPA / Hibernate ORM ─────────────────────────────────────── -->
        <!--
            WHY Spring Data JPA?
            Removes boilerplate CRUD; gives us JpaSpecificationExecutor for
            composable, type-safe dynamic queries without raw SQL strings.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- ── Spring Security ─────────────────────────────────────────── -->
        <!--
            WHY Security starter?
            Provides CSRF, CORS, method-level security, filter chain — all
            we do is plug in our JWT filter and configure permit/deny rules.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- ── Bean Validation (Jakarta) ──────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ── H2 Database (file-based for dev, in-memory for tests) ──── -->
        <!--
            WHY H2?
            Zero-install, file-persisted .mv.db for development; switches to
            mem mode under @ActiveProfiles("test") for fast, isolated tests.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ── JWT (JJWT library — split into API + impl + Jackson) ───── -->
        <!--
            WHY three JARs?
            jjwt-api  → compile-time API (no impl details leak into code)
            jjwt-impl → runtime parser/signer (runtime scope keeps code clean)
            jjwt-jackson → JSON serialisation of JWT claims via Jackson
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ── Lombok (compile-time code generation) ───────────────────── -->
        <!--
            WHY optional?
            Lombok is a compile-time annotation processor; consumers of this
            library don't need it on their classpath.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ── Testing ─────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
                WHY explicit compiler plugin config?
                From Java 21+ with newer runtimes (Java 24/25), Lombok must be
                declared as an annotationProcessorPath so javac discovers it
                before compiling source files — otherwise getters/builders are
                never generated and compilation fails with "cannot find symbol".
            -->

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Exclude Lombok from the final fat JAR -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
